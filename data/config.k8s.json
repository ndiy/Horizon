{
  "ai": {
    "provider": "openai",
    "model": "deepseek-v4.1-flash-eco",
    "base_url": "https://ada.great-wrasse.ts.net/v1",
    "api_key_env": "",
    "temperature": 0.3,
    "max_tokens": 4096,
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1,
    "languages": ["zh"]
  },
  "processing": {
    "profiles_dir": "/app/profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      },
      "tech-blog": {
        "threshold": 4.0,
        "topic_dedup": false
      }
    }
  },
  "display": {
    "icon_style": "emoji"
  },
  "sources": {
    "github": [],
    "hackernews": {
      "enabled": true,
      "fetch_top_stories": 20,
      "min_score": 100,
      "profile": "tech-news"
    },
    "rss": [
      {
        "name": "Simon Willison",
        "url": "https://simonwillison.net/atom/everything/",
        "enabled": true,
        "category": "ai-tools",
        "profile": "tech-news"
      },
      {
        "name": "vLLM Blog",
        "url": "https://vllm.ai/blog/rss.xml",
        "enabled": true,
        "category": "llm-inference",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "Sean Goedecke",
        "url": "https://www.seangoedecke.com/rss.xml",
        "enabled": true,
        "category": "software-engineering",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      },
      {
        "name": "NVIDIA CUDA Technical Blog",
        "url": "https://developer.nvidia.com/blog/tag/cuda/feed/",
        "enabled": true,
        "category": "cuda",
        "profile": "tech-blog",
        "content_extractor": "trafilatura"
      }
    ],
    "reddit": {
      "enabled": false,
      "subreddits": [],
      "users": [],
      "fetch_comments": 0
    },
    "telegram": {
      "enabled": false,
      "channels": []
    },
    "twitter": {
      "enabled": false,
      "users": [],
      "keywords": []
    },
    "openbb": {
      "enabled": false,
      "watchlists": [],
      "fetch_filings": false
    },
    "ossinsight": {
      "enabled": false,
      "languages": [],
      "keywords": [],
      "max_items": 1
    },
    "gdelt": {
      "enabled": false
    },
    "google_news": {
      "enabled": false
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 20,
    "profile_order": ["tech-news", "tech-blog"]
  },
  "webhook": {
    "enabled": false
  },
  "wechat": {
    "enabled": false
  }
}
