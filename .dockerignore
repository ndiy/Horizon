# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/

# Git
.git/
.github/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Documentation
*.md
!README.md
!profiles/**/*.md
# The docs site tree is a build input for Dockerfile.site only; keep its
# Markdown, SVG and asset files reachable while still excluding generated posts.
!docs/**
docs/_posts/
docs/_site/

# Local configuration, data, and runtime secrets
.env
data/*
!data/config.example.json
!data/presets.json

# Build artifacts
*.egg-info/
dist/
build/
.bundle/
vendor/bundle/

# Misc
todo.txt
.claude/
